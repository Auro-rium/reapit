# Backboard's OpenAI-compatible endpoint and credentials
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
# Verified working with this Backboard account.
BACKBOARD_MODEL=gpt-5.6-luna

# Visual browser-use agent (OpenAI-compatible visual model)
BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=
BROWSER_USE_MODEL=google/gemini-3.1-flash-lite-image

# Per-agent output-token budgets (override defaults if needed)
REAPIT_UIUX_MAX_TOKENS=50000
REAPIT_PLANNER_MAX_TOKENS=1200
REAPIT_MARKDOWN_MAX_TOKENS=2400
REAPIT_STRUCTURE_MAX_TOKENS=1600
REAPIT_METADATA_MAX_TOKENS=1200
REAPIT_CONTRIBUTORS_MAX_TOKENS=1000
REAPIT_LINKS_MAX_TOKENS=1600
REAPIT_SPECIALIST_MAX_TOKENS=2400
REAPIT_UI_STRATEGY_MAX_TOKENS=1800
REAPIT_UI_ARCHITECTURE_MAX_TOKENS=1800
REAPIT_UI_ACCESSIBILITY_MAX_TOKENS=1600
REAPIT_UI_DIAGRAMS_MAX_TOKENS=1600
REAPIT_UI_QA_MAX_TOKENS=2400

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=reapit

MAX_REPO_BYTES=50000000
MAX_FILE_CHARS=30000
MAX_LINKS=8
